#!/usr/bin/env bash
set -euo pipefail

# Quick pre-commit hook: run lightweight checks on staged files.
# Requires developer to run `pnpm install` and optionally `pnpm run setup:hooks` to enable hooks.

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|json|md)$' || true)
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "Running quick lint/format on staged files..."

# Run biome (fast) on staged files. Falls back cleanly if biome not installed.
if command -v pnpm >/dev/null 2>&1; then
  pnpm -s exec biome check $STAGED_FILES || { echo "biome check failed on staged files"; exit 1; }
  pnpm -s exec biome format --write $STAGED_FILES || true
  git add $STAGED_FILES
else
  echo "pnpm not found; skipping lint checks (run pnpm install to enable pre-commit checks)"
fi

exit 0
