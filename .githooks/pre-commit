#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook: fast linting on staged files
# Runs biome check for quick feedback before commit
# Usage: git config core.hooksPath .githooks && chmod +x .githooks/pre-commit

cd "$(git rev-parse --show-toplevel)" || exit 1

# Change to monorepo subdirectory where package.json lives
if [ -d "interviewQuestions/llm-web-refactoring-test-gogogo1024" ]; then
  cd interviewQuestions/llm-web-refactoring-test-gogogo1024
fi

# Get staged files matching code extensions
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|json|md)$' || true)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "🔍 Pre-commit: linting staged files..."

# Check if pnpm is available
if ! command -v pnpm >/dev/null 2>&1; then
  echo "⚠️  pnpm not found; install dependencies with: pnpm install"
  exit 0
fi

# Run biome check on staged files only (non-fatal for now, can be made strict)
if pnpm exec biome check --staged-files $STAGED_FILES 2>/dev/null; then
  echo "✅ Pre-commit checks passed"
  exit 0
else
  echo "⚠️  Pre-commit check issues found. Run 'pnpm lint:fix' to auto-fix"
  exit 0  # Allow commit; lint failures caught in CI
fi
