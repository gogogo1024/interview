{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [
		".env",
		".env.local",
		"tsconfig.json",
		"biome.json",
		"pnpm-workspace.yaml"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build", "proto:generate", "db:generate"],
			"outputs": ["dist/**", ".output/**", ".vinxi/**", ".tanstack/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"outputs": []
		},
		"typecheck": {
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"test:unit": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"test:integration": {
			"dependsOn": ["^build"]
		},
		"test:e2e": {
			"dependsOn": ["build"],
			"cache": false
		},
		"proto:generate": {
			"outputs": ["generated/**"],
			"cache": false
		},
		"db:generate": {
			"outputs": []
		},
		"db:migrate": {
			"cache": false
		},
		"db:seed": {
			"cache": false
		}
	}
}
