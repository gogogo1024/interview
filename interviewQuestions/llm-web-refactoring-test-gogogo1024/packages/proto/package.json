{
	"name": "@chirp/proto",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/src/index.js",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		},
		"./protos/*": "./protos/*"
	},
	"scripts": {
		"proto:generate": "pnpm exec protoc --plugin=protoc-gen-ts=./node_modules/.bin/protoc-gen-ts --ts_out ./generated --proto_path ./protos ./protos/*.proto",
		"typecheck": "pnpm run proto:generate && tsc --noEmit",
		"build": "pnpm run proto:generate && tsc -p tsconfig.json"
	},
	"dependencies": {
		"@protobuf-ts/runtime": "^2.9.4",
		"@protobuf-ts/runtime-rpc": "^2.9.4"
	},
	"devDependencies": {
		"@protobuf-ts/plugin": "^2.9.4",
		"@protobuf-ts/protoc": "^2.9.4",
		"typescript": "^5.7.2"
	}
}
