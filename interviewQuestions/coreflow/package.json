{
  "name": "coreflow-ai-platform",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @coreflow/prisma-models db:generate",
    "db:migrate": "pnpm --filter @coreflow/prisma-models db:migrate"
  },

  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.10",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3"
  }

}
